PROJECT_ENDPOINT="https://<your-project-name>.services.ai.azure.com/api/projects/<your-project-name>"
AGENT_NAME="streamlit-agent"
# Name of the Foundry agent to talk to. For agents created in the current Foundry
# portal the name is also the ID, for example "streamlit-agent-new-version".
FOUNDRY_AGENT_ID="<your-agent-name>"
# Only needed when the agent does not exist yet: the app creates it from this model
# deployment name (as shown under "Models + endpoints" in the Foundry portal).
FOUNDRY_MODEL_NAME="<your-model-deployment-name>"
# Optional: instructions for an agent the app creates.
# AGENT_INSTRUCTIONS="You are a helpful assistant that answers general questions."
# Optional: use a full project connection string instead of PROJECT_ENDPOINT.
# PROJECT_CONNECTION_STRING="endpoint=https://<your-resource>.services.ai.azure.com;subscription_id=<subscription-id>;resource_group=<resource-group>;project_name=<project-name>"
